<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BusinessTourLive</AssemblyName>
    <RootNamespace>BusinessTourLive</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\index.html" LogicalName="Web.index.html" />
    <EmbeddedResource Include="..\styles.css" LogicalName="Web.styles.css" />
    <EmbeddedResource Include="..\data.js" LogicalName="Web.data.js" />
    <EmbeddedResource Include="..\engine.js" LogicalName="Web.engine.js" />
    <EmbeddedResource Include="..\app.js" LogicalName="Web.app.js" />
    <EmbeddedResource Include="..\live-bridge.js" LogicalName="Web.live-bridge.js" />
  </ItemGroup>
</Project>
